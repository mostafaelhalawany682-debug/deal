# انسخ الملف إلى .env للتشغيل المحلي، أو اضبط نفس المتغيرات من لوحة Vercel (Settings → Environment Variables)

# رابط اتصال PostgreSQL من Supabase:
# لوحة Supabase ← Settings ← Database ← Connection string
# للنشر على Vercel استخدم رابط الـ Transaction Pooler (المنفذ 6543) حتى لا تنفد الاتصالات
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# رقم محفظة عمولات Deal (فودافون كاش / إنستاباي) — يبقى في الخادم فقط
# ولا يظهر إلا للعميل الدافع داخل خطوة دفع العمولة في حجز مؤكد
COMMISSION_PHONE=

# منفذ التشغيل المحلي فقط (Vercel يدير المنفذ بنفسه)
PORT=3000
